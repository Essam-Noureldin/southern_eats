# Public site URL (used for metadata, OG, sitemap). Required.
# Example: https://samssoutherneatery.com
NEXT_PUBLIC_SITE_URL=

# GA4 Measurement ID. Optional — empty disables Google Analytics entirely.
NEXT_PUBLIC_GA_ID=

# Sentry DSN. Optional — empty disables error reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Where contact form submissions are received (private). Required.
CONTACT_FORM_TO_EMAIL=

# Verified Resend sender. Optional — empty puts lib/email.ts in stub mode
# (logs submissions to server console, returns success).
# For demo deploys without a verified domain, use: onboarding@resend.dev
CONTACT_FORM_FROM_EMAIL=

# Resend API key (private). Optional — empty puts lib/email.ts in stub mode.
RESEND_API_KEY=

# Contact form rate-limiting (per IP). Required.
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=600000

# Cookie consent banner. Required (UK/EU/CA).
COOKIE_CONSENT_REQUIRED=true
